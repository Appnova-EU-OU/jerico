{
  "name": "@bridge/mcp-server",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "description": "Bridge MCP server — exposes Bridge project data to Claude Code agents",
  "main": "./dist/index.cjs",
  "bin": {
    "bridge-mcp": "./dist/index.cjs"
  },

{
  "name": "@jerico/shared",
  "version": "1.7.1",
  "license": "Apache-2.0",
  "description": "Shared types and constants for Jerico packages",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./test-utils": {
      "types": "./dist/test-utils/index.d.ts",
      "import": "./dist/test-utils/index.js",
      "require": "./dist/test-utils/index.js"
    }
  },
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "typescript": "^5.0.0"
  }
}

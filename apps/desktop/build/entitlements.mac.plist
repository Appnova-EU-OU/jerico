<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for V8 JIT compilation in the Electron renderer -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Required for Electron's context-isolated renderers -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Required for bridge-agent (pkg binary): embeds node runtime and node-pty
       native addon; all three have unsigned code pages that would be rejected
       by hardened runtime without this entitlement. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Required because the daemon is launched via ELECTRON_RUN_AS_NODE=1 which
       injects DYLD_INSERT_LIBRARIES / DYLD_LIBRARY_PATH into the child process. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>

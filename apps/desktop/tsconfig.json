{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "out/main",
    "rootDir": "src"
  },
  "include": ["src/main/**/*"],
  "exclude": ["node_modules", "out", "dist"]
}
